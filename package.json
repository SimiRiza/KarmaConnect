{
  "name": "karmaconnect-monorepo",
  "version": "1.0.0",
  "description": "KarmaConnect - Community-Impact Platform (MERN Stack)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "build:client": "npm run build --prefix client",
    "test:server": "npm test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "mern",
    "social-impact",
    "volunteering",
    "csr",
    "ngo"
  ],
  "author": "KarmaConnect Team",
  "license": "ISC"
}
