# =====================================================
# KarmaConnect — Environment Configuration
# =====================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS and email links)
CLIENT_URL=http://localhost:5173

# Database Configuration
# NGO transactions require a replica set (MongoDB Atlas or local --replSet rs0).
# USE_IN_MEMORY_DB=true attempts an isolated development replica set; data is temporary.
# MongoDB connection URI (e.g., local MongoDB or MongoDB Atlas URI)
# If local MongoDB is unavailable, setting USE_IN_MEMORY_DB=true starts an in-memory database for rapid local development
MONGODB_URI=mongodb://localhost:27017/karmaconnect
USE_IN_MEMORY_DB=true

# Authentication Secrets & Settings
# Production requires different random values, each at least 32 characters.
# Blank values retain the existing development-only fallback keys.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Feature Flags
# If true, users cannot log in until they verify their email
REQUIRE_EMAIL_VERIFICATION=false

# Email (Nodemailer) Configuration
# In development mode, if SMTP is unconfigured, verification and reset links are printed to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Required in production: absolute paths backed by persistent storage.
# Leave blank for the existing local development directories.
# Private evidence must not overlap public uploads or any publicly served directory.
UPLOAD_DIR=
VERIFICATION_EVIDENCE_DIR=

# Optional: comma-separated trusted reverse-proxy IP addresses/subnets.
# Leave blank for no proxy trust. Do not use true, hop counts or /0 ranges.
TRUST_PROXY=

# Project budgets above this INR amount require an authority evidence review.
LARGE_PROJECT_THRESHOLD=50000

# First administrator (operator-supplied; no public admin signup)
ADMIN_EMAIL=
ADMIN_PASSWORD=
