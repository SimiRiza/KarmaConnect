# =====================================================
# KarmaConnect — Environment Configuration
# =====================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS and email links)
CLIENT_URL=http://localhost:5173

# Database Configuration
# NGO transactions require a replica set (MongoDB Atlas or local --replSet rs0).
# USE_IN_MEMORY_DB=true attempts an isolated development replica set; data is temporary.
# MongoDB connection URI (e.g., local MongoDB or MongoDB Atlas URI)
# If local MongoDB is unavailable, setting USE_IN_MEMORY_DB=true starts an in-memory database for rapid local development
MONGODB_URI=mongodb://localhost:27017/karmaconnect
USE_IN_MEMORY_DB=true

# Authentication Secrets & Settings
# Secret for signing short-lived access tokens (15 minutes)
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production_32chars_min!
# Secret for signing longer-lived refresh tokens (7 days)
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_32chars_min!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Feature Flags
# If true, users cannot log in until they verify their email
REQUIRE_EMAIL_VERIFICATION=false

# Email (Nodemailer) Configuration
# In development mode, if SMTP is unconfigured, verification and reset links are printed to the console
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=KarmaConnect <noreply@karmaconnect.org>
